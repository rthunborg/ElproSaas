{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "elpro-pilot-availability-monitor-local-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-15",
  "workers_dev": false,
  "vars": {
    "MONITOR_URL": "https://elpro-saas.vercel.app/login",
    "MONITOR_SENDER": "monitor@example.invalid",
    "MONITOR_DESTINATION": "monitor-alert@example.invalid",
    "MONITOR_TEST_OUTCOME": "failed"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR",
        "class_name": "AvailabilityMonitor"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AvailabilityMonitor"]
    }
  ],
  "send_email": [
    {
      "name": "ALERT_EMAIL",
      "destination_address": "monitor-alert@example.invalid",
      "allowed_sender_addresses": ["monitor@example.invalid"]
    }
  ]
}
