{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    // tests/integration/** is re-enrolled in typecheck by Story 2.2 (Task 6.6):
    // the Vitest runner + DB-backed suites now exist, so they are type-checked.
    // tests/e2e/** stays excluded — its browser runner (Playwright) is out of
    // THIS story's scope (deferred; owner: a later E2E/Story-2.4 task). The e2e
    // scaffold uses bare describe/it globals with no runner types and would not
    // type-check until that runner lands.
    "tests/e2e/**",
    // Story 2.3 RED-PHASE ATDD scaffolds (TEA testarch-atdd): these failing
    // acceptance tests deliberately import `@/server/commands/*` modules + the
    // `tests/factories/audit-events` helper that do NOT exist until Story 2.3
    // dev-story implements them, so they cannot type-check yet (same rationale as
    // the e2e exclusion above). dev-story REMOVES these two globs when it lands the
    // modules + migration, re-enrolling the suites into typecheck as they flip GREEN.
    "tests/unit/server/commands/**",
    "tests/integration/commands/**"
  ]
}
