{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "scripts/**/*.mjs"
  ],
  "exclude": [
    "node_modules",
    // tests/integration/** is re-enrolled in typecheck by Story 2.2 (Task 6.6):
    // the Vitest runner + DB-backed suites now exist, so they are type-checked.
    // tests/e2e/** stays excluded — its browser runner (Playwright) is out of
    // THIS story's scope (deferred; owner: a later E2E/Story-2.4 task). The e2e
    // scaffold uses bare describe/it globals with no runner types and would not
    // type-check until that runner lands.
    "tests/e2e/**"
    // Story 2.3 RE-ENROLLED its command suites into typecheck (dev-story landed
    // `@/server/commands/*` + `tests/factories/audit-events` + the migration, and
    // the suites flipped GREEN): the previous `tests/unit/server/commands/**` and
    // `tests/integration/commands/**` excludes are removed.
  ]
}
