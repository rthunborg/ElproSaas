{
  "name": "elpro",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs",
    "test:unit": "node --experimental-strip-types --import ./tests/support/register.mjs --test \"tests/unit/**/*.test.ts\"",
    "test:int": "vitest run",
    "test:int:watch": "vitest",
    "verify:lockfiles": "node scripts/verify/check-lockfiles.mjs",
    "verify:service-role-containment": "node scripts/verify/check-service-role-containment.mjs",
    "verify:bundle-containment": "node scripts/verify/check-bundle-containment.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.0",
    "@supabase/supabase-js": "2.108.2",
    "next": "16.2.9",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@types/node": "20.19.43",
    "@types/pg": "8.20.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.9",
    "pg": "8.22.0",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}
