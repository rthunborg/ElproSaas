# Elpro — Environment Variable Contract (Phase A)
#
# HOW TO USE
#   1. Copy this file to `.env.local` (Next.js loads it automatically) or `.env`.
#        cp .env.example .env.local
#   2. Fill each value from YOUR OWN dev Supabase project — never a shared
#      dev/staging/prod project (see docs/quality/ci.md, "Test Environment
#      Ground Rules" / architecture §18).
#   3. Never commit your filled-in file. `.env` and `.env.*` are gitignored;
#      only this `.env.example` is whitelisted (see .gitignore).
#
# SECURITY (docs/security/security-guardrails.md, NFR18)
#   - This file contains PLACEHOLDERS ONLY. No real project refs, keys, URLs, or
#     PII may ever be committed here.
#   - The service-role key is SERVER-ONLY. It bypasses Row Level Security and
#     must NEVER be prefixed `NEXT_PUBLIC_` and NEVER be imported into browser /
#     client code paths.
#   - Only `NEXT_PUBLIC_`-prefixed variables are exposed to the browser by
#     Next.js; everything else stays server-side.
#
# STATUS
#   These variable NAMES are the documented contract. The code that READS them
#   lands in Epic 2 (Story 2.1 — tenant-admin auth / tenant context, supabase-js
#   / @supabase/ssr). Nothing in the repo consumes these yet. If Epic 2's chosen
#   client library prefers slightly different names, that story updates this file.

# Public Supabase project URL — browser-safe.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Public anon key — browser-safe. RLS still enforces tenant isolation; this key
# does not grant privileged access on its own.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Public application origin used for Supabase Auth invitation, magic-link, and
# reset redirects. This must be the deployed HTTPS origin in production.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000

# SERVER-ONLY service-role key — bypasses RLS. Never expose to the browser,
# never prefix with NEXT_PUBLIC_, never import into client paths. Used only by
# server-side code (Epic 2+), with documented purpose and test coverage.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# SERVER-ONLY scheduler authentication (Story 13.1). Use a unique random value
# of at least 32 bytes. During rotation set the previous value and its ISO expiry.
# CRON_SECRET=replace-with-at-least-32-random-bytes
# CRON_PREVIOUS_SECRET=replace-with-previous-at-least-32-random-bytes
# CRON_PREVIOUS_SECRET_EXPIRES_AT=2026-10-01T00:00:00.000Z

# SERVER-ONLY operator-console kill switch (ADR-B010). Production/preview deny
# access unless exactly true. Unset is enabled only outside NODE_ENV=production;
# any explicit non-true value disables access in every environment.
# Set true in production only after the recorded production-readiness approval.
# A hosted env change requires a new deployment; revoke the DB operator allow-list
# for immediate containment while that deployment rolls out.
# TENANT_PROVISIONING_ENABLED=false

# Quote-PDF byte attestation (ADR-B008). SERVER-ONLY: this HMAC secret is used
# only by the server to attest rendered PDF bytes; it is not a review token and
# must never be exposed, logged, returned, or prefixed NEXT_PUBLIC_. The matching
# Supabase Vault secret is named quote_pdf_attestation_<key-id>.
# A disposable local test key may use key id test_v1. Production/demo require
# coordinated Vault + Vercel provisioning and rotation; see docs/process/demo-environment.md.
# QUOTE_PDF_ATTESTATION_KEY_ID=test_v1
# QUOTE_PDF_ATTESTATION_HMAC_SECRET=replace-with-local-test-only-secret

# Quote-send safety track. The application defaults to real_customer (which blocks an unresolved
# TAX_SIGN_OFF_REQUIRED warning); only a disposable fake-data demo may explicitly use demo.
# ELPRO_QUOTE_SEND_TRACK=demo

# (Optional) Signed-URL time-to-live in seconds for private file access
# (architecture §6 — TTL is env-configurable; keep it low in test envs). IN USE as of
# Epic 8 Story 8.1 — read by src/server/storage/signed-access.ts (safe default 300s if
# unset). A low value in a test env makes the signed-URL expiry testable (R-806).
# SUPABASE_SIGNED_URL_TTL_SECONDS=300
