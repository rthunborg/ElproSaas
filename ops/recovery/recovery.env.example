# Copy this file to `ops/recovery/.env` in the dedicated recovery worktree.
# It is ignored by Git. Values must be recovery-only and must not be printed.
# Keep passwords URL-safe because they appear in local service connection URLs.
POSTGRES_PASSWORD=replace-with-a-private-recovery-password
JWT_SECRET=replace-with-a-private-32-character-minimum-jwt-secret
ANON_KEY=replace-with-a-private-recovery-anon-jwt
SERVICE_ROLE_KEY=replace-with-a-private-recovery-service-role-jwt
# Storage API consumes SERVICE_KEY; it must equal SERVICE_ROLE_KEY above.
SERVICE_KEY=replace-with-the-same-private-recovery-service-role-jwt

GOTRUE_DB_DATABASE_URL=postgres://supabase_auth_admin:replace-with-a-private-recovery-password@db:5432/postgres
GOTRUE_SITE_URL=http://127.0.0.1:58000
GOTRUE_URI_ALLOW_LIST=http://127.0.0.1:58000
API_EXTERNAL_URL=http://127.0.0.1:58000/auth/v1
GOTRUE_JWT_SECRET=replace-with-a-private-32-character-minimum-jwt-secret
GOTRUE_JWT_ISSUER=http://127.0.0.1:58000/auth/v1

PGRST_DB_URI=postgres://authenticator:replace-with-a-private-recovery-password@db:5432/postgres
PGRST_JWT_SECRET=replace-with-a-private-32-character-minimum-jwt-secret
PGRST_APP_SETTINGS_JWT_SECRET=replace-with-a-private-32-character-minimum-jwt-secret

AUTH_JWT_SECRET=replace-with-a-private-32-character-minimum-jwt-secret
DATABASE_URL=postgres://supabase_storage_admin:replace-with-a-private-recovery-password@db:5432/postgres
STORAGE_PUBLIC_URL=http://127.0.0.1:58000
