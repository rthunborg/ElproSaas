# BMad install + per-tool agent harness config (.codex / .claude / .agents) and
# the BMAD module install (_bmad) are COMMITTED for this project so the Codex +
# Claude Code + BMAD setup is reproducible and shared across clones. See
# docs/process/claude-code-coexistence.md. Only personal, machine-local
# overrides stay ignored:
.claude/settings.local.json
.codex/config.local.toml

# Playwright E2E (TEA testarch-framework): browser report + traces + the seeded
# fixture credentials written by globalSetup are all ephemeral, never committed.
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
tests/e2e/.auth/
