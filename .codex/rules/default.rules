# Codex execpolicy rules for ElPro Phase A.
# Verified locally with: codex execpolicy check --rules .codex/rules/default.rules <command>
#
# Decisions used by Codex 0.137.0 on this machine:
# - allow
# - prompt
# - forbidden

# Read-only commands that are safe during docs/process work.
prefix_rule(["git", "status"], "allow", match=["git status --short"], not_match=["git push"])
prefix_rule(["git", "diff"], "allow", match=["git diff -- AGENTS.md"], not_match=["git reset --hard"])
prefix_rule(["git", "log"], "allow", match=["git log --oneline -5"], not_match=["git push"])
prefix_rule(["rg"], "allow", match=["rg --files docs"])

# Parity with Claude Code (.claude/settings.json): these previously prompted but
# now auto-allow so autonomous runs proceed hands-off. The destructive subset is
# still hard-blocked by the `forbidden` rules below (force-push, hard reset, prod
# Supabase, secrets). Codex uses most-specific-prefix-wins, so a longer forbidden
# prefix (e.g. `git push --force`) overrides the broader allow here — same pattern
# the existing `supabase db push` vs `--linked` pair already relies on.
prefix_rule(["npm", "install"], "allow", match=["npm install"], not_match=["npm test"])
prefix_rule(["npm", "update"], "allow", match=["npm update"])
prefix_rule(["bun", "install"], "allow", match=["bun install"])
prefix_rule(["npx"], "allow", match=["npx supabase --version"])
prefix_rule(["supabase", "db", "push"], "allow", match=["supabase db push"], not_match=["supabase migration list"])
prefix_rule(["supabase", "db", "reset"], "allow", match=["supabase db reset"])
prefix_rule(["supabase", "migration", "new"], "allow", match=["supabase migration new add_table"])
prefix_rule(["git", "reset"], "allow", match=["git reset --soft HEAD~1"])
prefix_rule(["git", "checkout", "--"], "allow", match=["git checkout -- src/App.tsx"], not_match=["git checkout feature/docs"])
prefix_rule(["git", "push"], "allow", match=["git push origin docs/guardrails"])
# NOTE: prefix rules cannot inspect the *wrapped* string inside a shell invocation,
# so allowing these means a shell-wrapped secret read (e.g. `pwsh -Command "cat .env"`)
# is NOT caught here. Claude Code catches it via the guard.ps1 regex hook; Codex has
# no active equivalent (hooks.json is proposal-only). Port guard.ps1 into a Codex
# PreToolUse hook if this gap matters — see codex-hooks-proposal.md.
prefix_rule(["powershell"], "allow", match=["powershell -NoProfile -Command \"echo hi\""])
prefix_rule(["pwsh"], "allow", match=["pwsh -NoProfile -Command \"echo hi\""])
prefix_rule(["cmd"], "allow", match=["cmd /c echo hi"])

# Still requires explicit approval (parity with Claude Code's lone `ask` gate).
prefix_rule(["gh", "pr", "merge"], "prompt", match=["gh pr merge 123"])

# Secret-reading commands are forbidden.
prefix_rule(["cat", ".env"], "forbidden", match=["cat .env"], not_match=["cat README.md"])
prefix_rule(["type", ".env"], "forbidden", match=["type .env"], not_match=["type README.md"])
prefix_rule(["Get-Content", ".env"], "forbidden", match=["Get-Content .env"], not_match=["Get-Content README.md"])
prefix_rule(["gc", ".env"], "forbidden", match=["gc .env"], not_match=["gc README.md"])
prefix_rule(["printenv"], "forbidden", match=["printenv"])
prefix_rule(["env"], "forbidden", match=["env"])
prefix_rule(["Get-ChildItem", "Env:"], "forbidden", match=["Get-ChildItem Env:"])
prefix_rule(["gci", "Env:"], "forbidden", match=["gci Env:"])
prefix_rule(["rg", ".", ".env"], "forbidden", match=["rg . .env"])

# Obvious destructive commands are forbidden.
prefix_rule(["rm", "-rf", "/"], "forbidden", match=["rm -rf /"])
prefix_rule(["rm", "-fr", "/"], "forbidden", match=["rm -fr /"])

# Destructive git operations forbidden (parity with Claude Code's guard.ps1).
# More specific than the `git reset`/`git push` allows above, so these win.
prefix_rule(["git", "reset", "--hard"], "forbidden", match=["git reset --hard"])
prefix_rule(["git", "push", "--force"], "forbidden", match=["git push --force"])
prefix_rule(["git", "push", "--force-with-lease"], "forbidden", match=["git push --force-with-lease"])
prefix_rule(["git", "push", "-f"], "forbidden", match=["git push -f"])

# Production-like Supabase targeting and secrets operations are forbidden until a release process exists.
prefix_rule(["supabase", "db", "push", "--linked"], "forbidden", match=["supabase db push --linked"])
prefix_rule(["supabase", "db", "push", "--project-ref"], "forbidden", match=["supabase db push --project-ref prod_ref"])
prefix_rule(["supabase", "functions", "deploy"], "forbidden", match=["supabase functions deploy fn --project-ref prod_ref"])
prefix_rule(["supabase", "secrets"], "forbidden", match=["supabase secrets list"])
prefix_rule(["supabase", "projects", "delete"], "forbidden", match=["supabase projects delete prod_ref"])

# Smoke test: verifies that this rules file is loaded.
prefix_rule(
    pattern = ["__codex_rule_smoke_test__"],
    decision = "forbidden",
    justification = "Verifies that this rules file is loaded.",
    match = ["__codex_rule_smoke_test__"],
)
